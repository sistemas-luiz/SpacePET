from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from typing import Optional
import math

app = FastAPI(
    title="AgroCycle AI — Backend API",
    description="API agronômica para balanço hídrico (FAO-56), estimativa de quebra (FAO-33) e vendas futuras.",
    version="2.0.0",
)

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

CROP_ECONOMICS = {
    "soja":     {"name": "Soja",     "unit": "sc", "yield_ha": 62.0,  "price": 128.0, "cost_ha": 4100.0},
    "milho":    {"name": "Milho",    "unit": "sc", "yield_ha": 115.0, "price": 58.0,  "cost_ha": 3900.0},
    "feijao":   {"name": "Feijão",   "unit": "sc", "yield_ha": 38.0,  "price": 235.0, "cost_ha": 4600.0},
    "mandioca": {"name": "Mandioca", "unit": "t",  "yield_ha": 26.0,  "price": 520.0, "cost_ha": 6800.0},
    "algodao":  {"name": "Algodão",  "unit": "@",  "yield_ha": 310.0, "price": 138.0, "cost_ha": 14500.0},
    "trigo":    {"name": "Trigo",    "unit": "sc", "yield_ha": 52.0,  "price": 76.0,  "cost_ha": 3200.0},
}


class SimulationRequest(BaseModel):
    crop: str = "soja"
    soil: str = "argiloso"
    irrigation: str = "sequeiro"
    area_ha: float = 84.5
    dap: int = 20
    temp_c: float = 22.8
    solar_mj: float = 18.4
    rain_mm_year: float = 1480.0
    rain_delta_pct: float = 0.0
    temp_delta_c: float = 0.0
    frost_active: bool = False
    yield_ha: Optional[float] = None
    price_brl: Optional[float] = None
    cost_ha_brl: Optional[float] = None
    hedge_pct: float = 45.0


def compute_et0_hargreaves(temp_c: float, solar_mj: float) -> float:
    return round(max(1.0, 0.0135 * (temp_c + 17.78) * (solar_mj / 2.45)), 2)


def compute_fao33_preservation(
    ky: float,
    rain_delta_pct: float,
    temp_delta_c: float,
    base_temp_c: float,
    solar_mj: float,
    mulch_reduction: float,
    irrigated: bool,
    frost_active: bool,
    frost_tolerance: float,
) -> int:
    if irrigated:
        eta_etc = max(0.75, min(1.0, 0.98 - max(0.0, temp_delta_c) * 0.015 + mulch_reduction * 0.05))
    else:
        et0_base = compute_et0_hargreaves(base_temp_c, solar_mj)
        et0_stressed = compute_et0_hargreaves(base_temp_c + temp_delta_c, solar_mj)
        effective_supply = (1.0 + rain_delta_pct / 100.0) * (1.0 + mulch_reduction * 0.38)
        eta_etc = max(0.35, min(1.0, effective_supply * (et0_base / et0_stressed)))
    preserved = (1.0 - ky * (1.0 - eta_etc)) * 100.0
    if frost_active:
        preserved -= (1.0 - frost_tolerance) * 22.0
    return int(round(max(22.0, min(99.0, preserved))))


@app.get("/api/health")
def health_check():
    return {"status": "ok", "service": "AgroCycle AI Backend", "mode": "hybrid-ready"}


@app.post("/api/simulate-futures")
def simulate_loss_and_futures(req: SimulationRequest):
    cfg = CROP_ECONOMICS.get(req.crop.lower(), CROP_ECONOMICS["soja"])
    yield_ha = req.yield_ha or cfg["yield_ha"]
    price = req.price_brl or cfg["price"]
    cost_ha = req.cost_ha_brl or cfg["cost_ha"]
    irrigated = req.irrigation.lower() == "irrigado"

    resilience_pct = compute_fao33_preservation(
        0.92, req.rain_delta_pct, req.temp_delta_c, req.temp_c, req.solar_mj, 0.35, irrigated, req.frost_active, 0.72
    )
    bare_soil_pct = compute_fao33_preservation(
        1.25, req.rain_delta_pct, req.temp_delta_c, req.temp_c, req.solar_mj, 0.0, irrigated, req.frost_active, 0.25
    )

    potential_vol = yield_ha * req.area_ha
    net_vol = potential_vol * (resilience_pct / 100.0)
    loss_vol = max(0.0, potential_vol - net_vol)
    loss_brl = round(loss_vol * price)

    bare_vol = potential_vol * (bare_soil_pct / 100.0)
    avoided_loss_brl = round(max(0.0, net_vol - bare_vol) * price)

    safe_hedge_limit_pct = max(20, min(70, int(round((resilience_pct * 0.65) / 5.0) * 5)))
    hedged_vol = net_vol * (req.hedge_pct / 100.0)
    hedged_brl = round(hedged_vol * price)
    spot_vol = max(0.0, net_vol - hedged_vol)
    spot_brl = round(spot_vol * price)
    total_cost_brl = round(cost_ha * req.area_ha)

    return {
        "crop": cfg["name"],
        "unit": cfg["unit"],
        "resilience_pct": resilience_pct,
        "loss_pct": 100 - resilience_pct,
        "potential_volume": round(potential_vol),
        "net_volume": round(net_vol),
        "loss_volume": round(loss_vol),
        "loss_brl": loss_brl,
        "avoided_loss_brl": avoided_loss_brl,
        "safe_hedge_limit_pct": safe_hedge_limit_pct,
        "hedged_volume": round(hedged_vol),
        "hedged_brl": hedged_brl,
        "spot_volume": round(spot_vol),
        "spot_brl": spot_brl,
        "net_profit_brl": (hedged_brl + spot_brl) - total_cost_brl,
    }

